{
  "expo": {
    "name": "SmartReviewAI",
    "slug": "smart-review-ai",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0F0F23"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartreviewai.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0F23"
      },
      "package": "com.smartreviewai.app",
      "permissions": ["INTERNET"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": []
  }
}
